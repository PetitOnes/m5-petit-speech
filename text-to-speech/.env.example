HOST=0.0.0.0
PORT=8766

# --- piper ---
PIPER_BIN=<PATH_TO_PIPER>/piper/bin/piper
PIPER_LD_LIBRARY_PATH=<PATH_TO_PIPER>/piper/lib
PIPER_MODEL_PATH=<PATH_TO_MODEL>/models/tsukuyomi-chan-6lang-fp16.onnx

PIPER_SPEAKER=0
PIPER_LENGTH_SCALE=1.0
PIPER_NOISE_SCALE=0.5
PIPER_NOISE_W=0.8
PIPER_SENTENCE_SILENCE=0.2

# --- kokoro (optional, defaults to ~/.local/share/kokoro/) ---
# KOKORO_MODEL_PATH=<PATH_TO_MODEL>/kokoro-v1.0.onnx
# KOKORO_VOICES_PATH=<PATH_TO_MODEL>/voices-v1.0.bin

# --- voicevox (optional, defaults to local engine on 50021) ---
# VOICEVOX_URL=http://127.0.0.1:50021

OUTPUT_DIR=./outputs
